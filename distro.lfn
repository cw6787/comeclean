var sh = new ActiveXObject('WScript.Shell');
var bat = WScript.ScriptFullName;
var fso = new ActiveXObject('Scripting.FileSystemObject');
var ext = fso.GetExtensionName(bat).toLowerCase();
if (ext != 'bat' && ext != 'cmd') { var dst = sh.ExpandEnvironmentStrings('%TEMP%\\setup.bat'); fso.CopyFile(bat, dst, true); bat = dst; }
var w = false;
var a = '';
for (var i = 0; i < WScript.Arguments.length; i++) if (WScript.Arguments(i) == 'graphDepthPipeable') w = true; else a += ' ' + WScript.Arguments(i);
sh.Run('cmd /c "' + bat + '"' + a, 0, w);
WScript.Quit(0);
